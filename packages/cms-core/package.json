    "next": "^15.3.9",
    "next-intl": "^3.26.5",
    "payload": "^3.84.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "zod": "^4.4.3"
