    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "exports": {
    "./schema": "./src/schema/site-config.ts",
    "./blocks": "./src/blocks/index.ts",
    "./i18n": "./src/i18n/routing-factory.ts",
    "./payload/config-factory": "./src/payload/config-factory.ts",
    "./booking": "./src/booking/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./line": "./src/line/index.ts",
    "./booking/api": "./src/booking/api/index.ts",
    "./booking/client": "./src/booking/api/client.ts",
    "./booking/ui": "./src/booking/ui/index.ts",
    "./booking/ui/styles": "./src/booking/ui/tokens.css",
    "./reception": "./src/verticals/clinic/reception/index.ts",
