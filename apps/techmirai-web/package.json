{
  "name": "techmirai-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "seed": "RUN_SEED=true NODE_OPTIONS=\"--require ./fix-next-env-interop.cjs\" tsx --env-file=.env.local src/seed/index.ts",
    "ringi:pdf": "tsx scripts/generate-ringi-pdf.ts",
    "seed:voice": "RUN_SEED=true NODE_OPTIONS=\"--require ./fix-next-env-interop.cjs\" tsx --env-file=.env.local src/seed/voice-pivot-run.ts",
    "seed:booking": "tsx --require ./fix-next-env-interop.cjs --env-file=.env.local src/seed/booking.ts",
    "db:apply-indexes": "NODE_OPTIONS=\"--require ./fix-next-env-interop.cjs\" tsx --env-file=.env.local scripts/apply-db-indexes.ts",
    "db:migrate-faq-keywords-category": "NODE_OPTIONS=\"--require ./fix-next-env-interop.cjs\" tsx --env-file=.env.local scripts/apply-faq-schema-migration.ts",
    "a11y": "tsx scripts/a11y-check.ts",
    "launch-scan:pages": "tsx scripts/launch-scan-pages.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@line/liff": "^2.30.0",
    "@next/env": "15.5.19",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/db-sqlite": "3.84.1",
    "@payloadcms/email-resend": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@techmirai/cms-core": "workspace:*",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/functions": "^3.7.7",
    "framer-motion": "^11.18.2",
    "fuse.js": "^7.1.0",
    "lucide-react": "^1.17.0",
    "next": "^15.3.9",
    "next-intl": "^3.26.5",
    "payload": "^3.84.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-flag-icons": "^1.0.6",
    "resend": "^6.18.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  }
}
