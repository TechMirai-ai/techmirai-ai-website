# Copy this file to .env.local and fill in real values.
# `cp .env.example .env.local`
#
# Every value below is a placeholder. Do not commit .env.local (it is
# already gitignored) and never reuse a secret across client projects.

# --- Required ---------------------------------------------------------

# `file:./local.db` for local dev, or a Postgres connection string for
# production. Do not use SQLite in production.
DATABASE_URI=file:../../.data/local.db

# Random string, unique per project. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# The site's public URL (used for CORS/CSRF allow-listing and absolute
# links). http://localhost:3000 for local dev.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Indexing guard (Pack-2/D2): must be exactly "production" for robots.txt to
# allow crawling and for the noindex response header to be omitted. Unset or
# any other value fails safe — robots.txt disallows everything and every
# response gets X-Robots-Tag: noindex — so a staging/demo deploy is never
# accidentally indexed. Leave unset for local dev.
SITE_ENV=

# --- Database (optional, but required to run `pnpm seed:demo`) --------

# Safety guard, not an adapter selector: `pnpm seed:demo` refuses to run
# unless this is exactly "development", so demo/placeholder content can
# never accidentally be seeded into a production database. Set to
# "development" for local dev; leave unset in production.
DATABASE_ENV=

# --- Media storage: Cloudflare R2 (optional) ---------------------------
# Omit all four to fall back to local disk storage in dev. Local disk is
# not durable across most hosting platforms' deploys — set these in any
# real deployment.

CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=

# Public base URL for the R2 bucket (or its CDN in front of it). Read by
# both the Payload media collection and the Next.js image loader/config —
# keep this as the single source of truth for that URL.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Email: Resend (optional, required for contact/booking emails) -----

RESEND_API_KEY=
FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# --- Booking (optional, required if features.bookingWidget uses the
# built-in engine rather than an external provider link) ---------------

# Random string, unique per project.
BOOKING_TOKEN_SECRET=

# Shared secret the daily reminder cron (vercel.json) must present.
CRON_SECRET=

# --- LINE Messaging API (optional, required for the LINE webhook —
# apps/techmirai-web/src/app/api/line/webhook/route.ts) --------------------
# Both come from the LINE Developers Console, under the client's Messaging
# API channel (Basic settings tab). Never share a channel secret/token
# across client projects — each client gets their own LINE provider and
# channels (see docs/STEP2-LINE-CATALOGUE.md Part 1).

# Verifies the webhook's x-line-signature header. Required for the webhook
# to accept any request at all — unset, it fails loudly (500) rather than
# silently rejecting everything as unsigned.
LINE_CHANNEL_SECRET=

# Used to reply to follow events (free — no message quota consumed) AND to
# push customer notifications (booking confirmation, day-before reminder —
# these always consume the message quota, see docs/STEP2-LINE-CATALOGUE.md
# Part 0.4) via LineMessagingChannel. Optional: a client without this set
# simply never gets picked by the channel-selection function — every
# customer falls back to email, same as before LINE existed.
LINE_CHANNEL_ACCESS_TOKEN=

# --- LINE Login / LIFF (optional, required for the LIFF booking flow —
# apps/techmirai-web/src/app/(liff)) ----------------------------------------
# Come from a separate LINE Login channel (NOT the Messaging API channel
# above) under the same provider — LIFF apps have been registered only
# under LINE Login channels since a Feb 2020 platform change. See
# docs/STEP2-LINE-CATALOGUE.md Part 1.

# The LINE Login channel ID. Used server-side as the `client_id` when
# verifying a LIFF ID token against LINE's own /oauth2/v2.1/verify
# endpoint — required for the reserve and line-customer-lookup routes to
# trust a LIFF session's lineUserId at all.
LINE_LOGIN_CHANNEL_ID=

# Not currently read by any code in this app — LIFF's getIDToken() flow
# verifies via LINE_LOGIN_CHANNEL_ID alone, no channel secret / OAuth2
# code exchange needed. Kept here because the LINE Developers Console
# issues it alongside LINE_LOGIN_CHANNEL_ID and a future LINE Login flow
# (e.g. a non-LIFF sign-in) would need it.
LINE_LOGIN_CHANNEL_SECRET=

# Public — read client-side by the LIFF page to call liff.init({liffId}).
# Registered under the LINE Login channel above (LINE Developers Console →
# LIFF tab → Add).
NEXT_PUBLIC_LIFF_ID=

# A SEPARATE LIFF app registered for the self-service manage page
# (/[locale]/line/manage — STEP 2 Part 4), NOT the same LIFF ID as the
# booking page above. LIFF apps are one endpoint URL per app — appending a
# subpath to a LIFF URL does not change which endpoint loads (verified
# against LINE's docs), so a second distinct page needs its own registered
# LIFF app under the same LINE Login channel, with its own Endpoint URL
# (https://<domain>/<locale>/line/manage).
NEXT_PUBLIC_LIFF_MANAGE_ID=

# --- Anti-spam: Cloudflare Turnstile (optional) -------------------------
# Server-side secret only. The client-side site key is read from
# site.config.ts's integrations.turnstileSiteKey, not from an env var.

TURNSTILE_SECRET_KEY=

# --- Reception AI fallback: Groq (required for POST /api/reception/ai) --
# The reception widget's free-text question node answers from an LLM
# grounded on this site's own CMS content. Without a key the endpoint
# still responds — every visitor simply gets the fixed "please call us"
# message instead of an answer, which is the same degradation as a Groq
# outage. Nothing else in the app is affected.
#
# Create at https://console.groq.com/keys (free tier). One key per client
# project; never reuse across projects.
GROQ_API_KEY=

# Optional model override. Defaults to openai/gpt-oss-20b, chosen for
# Groq's free tier. Only set this to move to a different Groq model.
GROQ_MODEL=

# --- AI chat widget (optional, required when features.aiAgent is true) -
# NOTE: AI_AGENT_BASE_URL/AI_AGENT_API_KEY belong to the dormant
# /api/ai/query proxy (an external agent microservice that was never
# stood up for this deployment). The reception AI does NOT use them — it
# calls Groq directly with GROQ_API_KEY above. AI_CORPUS_SECRET still
# gates GET /api/ai/corpus for external consumers.

AI_AGENT_BASE_URL=
AI_AGENT_API_KEY=
AI_CORPUS_SECRET=

# --- Rate limiting: Upstash Redis (optional) ----------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
