{
  "name": "techmirai-ai-website",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "seed": "pnpm --filter techmirai-web seed",
    "preflight": "node scripts/preflight-check.mjs",
    "preflight:launch": "node scripts/preflight-check.mjs --launch",
    "a11y": "pnpm --filter techmirai-web a11y"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  }
  
}
